# ==========================================================
# Scriptorium Environment Configuration Template
# ==========================================================

# --- Backend / Cloud Functions (functions/.env) ---
# Google AI Studio API Key for Gemini 2.5 Flash
GEMINI_API_KEY=your_gemini_api_key_here

# GCP Project ID
GCP_PROJECT_ID=scriptorium-503507

# Vertex AI Search Configuration (Discovery Engine)
VERTEX_SEARCH_PROJECT_NUMBER=559751767113
VERTEX_SEARCH_DATASTORE_ID=talent-search-connector_1785766300992_gcs_store
VERTEX_SEARCH_LOCATION=eu
AI_SEARCHABLE_BUCKET=scriptorium-searchable
AI_UPLOADS_BUCKET=scriptorium-uploads-503507

# Functions Server Port (for standalone local dev if applicable)
FUNCTIONS_PORT=5001

# --- Frontend (frontend/.env) ---
# Firebase Web App Config (scriptorium-503507)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=scriptorium-503507.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scriptorium-503507
VITE_FIREBASE_STORAGE_BUCKET=scriptorium-503507.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Backend Functions Base URL (without trailing slash)
# For Firebase Emulator: http://127.0.0.1:5001/scriptorium-503507/us-central1
VITE_API_BASE_URL=http://127.0.0.1:5001/scriptorium-503507/us-central1

# Active Supervisor Project Document ID
VITE_PROJECT_ID=project-default
